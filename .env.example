# Configuración del Modelo
MODEL_NAME=deepseek-ai/DeepSeek-OCR-2
BASE_SIZE=1024
IMAGE_SIZE=768

# GPU Configuration
CUDA_VISIBLE_DEVICES=0

# Hugging Face Cache
HF_HOME=/root/.cache/huggingface

# API Configuration
MAX_FILE_SIZE=10485760

# Local verification without GPU (0 off, 1 canned model adapter)
OCR_FAKE_MODE=0
# Set to "empty" to verify the empty-result UI path
OCR_FAKE_RESULT=
